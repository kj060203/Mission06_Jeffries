@model Mission06_Jeffries.Models.Movie

<h2>Add a New Movie</h2>

<!-- Form to add/edit movie -->

<form method="post">

    <input type = "hidden" asp-for="MovieId" /> 
    <br />

    
    <!-- Title -->
    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" required />
    </div>


    
    <!-- Dropdown for Category ... connects to category.cs -->
    <div class="form-group">
        <label asp-for="CategoryID">Category</label>
        <select asp-for="CategoryID">
            <option value="">Select a Category</option>
            @foreach (Category c in ViewBag.Categories)
            {
                <option value="@c.CategoryID">@c.CategoryName</option>
            }
        </select>
    </div>


    <!-- Year, limit past 1888 -->
    <div class="form-group">
        <label asp-for="Year"></label>
        <input asp-for="Year" class="form-control" type="number" min="1888" max="2025" required />
    </div>


    <!-- Director -->
    <div class="form-group">
        <label asp-for="Director"></label>
        <input asp-for="Director" class="form-control" />
    </div>

    <!-- Dropdown for Rating -->
    <div class="form-group">
        <label asp-for="Rating"></label>
        <select asp-for="Rating" class="form-control">
            <option value="">Select a Rating</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>

    <!-- Yes/No (True/False) Toggle for Edited -->
    <div class="form-group">
        <label asp-for="Edited"></label>
        <select asp-for="Edited" class="form-control" required>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <!-- Lent to-->
    <div class="form-group">
        <label asp-for="LentTo"></label>
        <input asp-for="LentTo" class="form-control" />
    </div>

    <!-- Notes, limit to 25-->
    <div class="form-group">
        <label asp-for="Notes"></label>
        <input asp-for="Notes" class="form-control" maxlength="25" />
    </div>


    <!-- Copied to plex-->
    <div class="form-group">
        <label asp-for="CopiedToPlex">Copied to Plex</label>
        <select asp-for="CopiedToPlex" class="form-control" required>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Add Movie</button>
</form>
